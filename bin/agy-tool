#!/usr/bin/env python3
import sys
import os
import argparse
import json

# Add parent dir to sys.path to allow module imports
current_dir = os.path.dirname(os.path.abspath(__file__))
parent_dir = os.path.dirname(current_dir)
if parent_dir not in sys.path:
    sys.path.insert(0, parent_dir)

from agy_tools.modules import sys_tool, code_tool, secure_tool, debug_tool
from agy_tools.utils import emit_result

def build_parser():
    parser = argparse.ArgumentParser(
        prog="agy-tool",
        description="JarvisOS & AGY Dynamic Autonomous Toolsuite for High-Speed & Token-Efficient Operations."
    )
    parser.add_argument("--describe", action="store_true", help="Return schema and capabilities of all tools in JSON")
    
    subparsers = parser.add_subparsers(dest="module", help="Tool modules")
    
    # === SYS MODULE ===
    sys_p = subparsers.add_parser("sys", help="System resources, ports & docker monitoring")
    sys_sub = sys_p.add_subparsers(dest="action")
    
    sys_ports_p = sys_sub.add_parser("ports", help="Scan allocated ports (15800-15900)")
    sys_ports_p.add_argument("--start", dest="start_port", type=int, default=15800)
    sys_ports_p.add_argument("--end", dest="end_port", type=int, default=15900)
    
    sys_sub.add_parser("status", help="Get CPU, RAM and Disk status")
    sys_sub.add_parser("docker", help="Get rootless docker containers status")
    
    # === CODE MODULE ===
    code_p = subparsers.add_parser("code", help="AST & architectural blueprints extraction")
    code_sub = code_p.add_subparsers(dest="action")
    
    code_bp = code_sub.add_parser("blueprint", help="Extract high-level file and module map")
    code_bp.add_argument("path", nargs="?", default=".", help="Project path")
    
    code_ep = code_sub.add_parser("endpoints", help="Extract API routes / endpoints")
    code_ep.add_argument("path", nargs="?", default=".", help="Project path")
    
    # === SECURE MODULE ===
    sec_p = subparsers.add_parser("secure", help="Security sanitization and secret masking")
    sec_sub = sec_p.add_subparsers(dest="action")
    
    sec_scan = sec_sub.add_parser("scan", help="Scan files for leaked credentials")
    sec_scan.add_argument("path", help="Target file or directory")
    
    sec_redact = sec_sub.add_parser("redact", help="Redact secrets in place")
    sec_redact.add_argument("path", help="Target file path")
    sec_redact.add_argument("--dry-run", action="store_true", help="Do not overwrite file")
    
    # === DEBUG MODULE ===
    dbg_p = subparsers.add_parser("debug", help="Error log diagnosis, stacktrace parser and typecheck")
    dbg_sub = dbg_p.add_subparsers(dest="action")
    
    dbg_trace = dbg_sub.add_parser("trace", help="Analyze stack trace log")
    dbg_trace.add_argument("log", nargs="?", default="", help="Raw stack trace string or log")
    
    dbg_chk = dbg_sub.add_parser("check", help="Fast syntax / typecheck")
    dbg_chk.add_argument("path", nargs="?", default=".", help="Target project directory")
    
    return parser

def main():
    parser = build_parser()
    args = parser.parse_args()
    
    if args.describe or not args.module:
        capabilities = {
            "name": "agy-tool",
            "version": "1.1.0",
            "modules": {
                "sys": sys_tool.get_sys_describe(),
                "code": code_tool.get_code_describe(),
                "secure": secure_tool.get_secure_describe(),
                "debug": debug_tool.get_debug_describe()
            }
        }
        emit_result(capabilities)
        return
        
    try:
        if args.module == "sys":
            if args.action == "ports":
                sys_tool.run_sys_ports(args)
            elif args.action == "docker":
                sys_tool.run_sys_docker(args)
            elif args.action == "status" or not args.action:
                sys_tool.run_sys_status(args)
            else:
                emit_result(None, success=False, error=f"Noma'lum sys buyrug'i: {args.action}")
                
        elif args.module == "code":
            if args.action == "blueprint":
                code_tool.run_code_blueprint(args)
            elif args.action == "endpoints" or not args.action:
                code_tool.run_code_endpoints(args)
            else:
                emit_result(None, success=False, error=f"Noma'lum code buyrug'i: {args.action}")
                
        elif args.module == "secure":
            if args.action == "scan":
                secure_tool.run_secure_scan(args)
            elif args.action == "redact":
                secure_tool.run_secure_redact(args)
            else:
                emit_result(None, success=False, error=f"Noma'lum secure buyrug'i: {args.action}")
                
        elif args.module == "debug":
            if args.action == "trace":
                debug_tool.run_debug_trace(args)
            elif args.action == "check" or not args.action:
                debug_tool.run_debug_check(args)
            else:
                emit_result(None, success=False, error=f"Noma'lum debug buyrug'i: {args.action}")
                
        else:
            emit_result(None, success=False, error=f"Noma'lum modul: {args.module}")
            
    except Exception as e:
        emit_result(None, success=False, error=str(e))

if __name__ == "__main__":
    main()
