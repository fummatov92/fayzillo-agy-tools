# ============================================================================
# AGY-TOOL CONFIGURATION TEMPLATE
# Nusxalab oling: cp .env.example .env
# ============================================================================

# 1. Path Jailing & Security
# Ruxsat etilgan asosiy jildlar (vergul bilan ajratilgan)
AGY_ALLOWED_DIRS=~/Desktop,~/.local,~/.gemini,~/Downloads

# 2. Port Scanner Boundaries (sys module)
AGY_PORT_RANGE_START=15800
AGY_PORT_RANGE_END=15900

# 3. Logging & Auditing
AGY_LOG_DIR=~/.local/state/agy-tool
AGY_MAX_LOG_SIZE_MB=5

# 4. Media & Multimodal Temporary Artifacts
AGY_TEMP_MEDIA_DIR=~/Desktop/temp/media_artifacts
AGY_TEMP_SUPER_MEDIA_DIR=~/Desktop/temp/super_media_artifacts

# 5. Biometric Face Recognition (face module)
# Shifrlash paroli (ixtiyoriy, agar berilmasa ~/.gemini/.face_key ishlatiladi)
# AGY_BIOMETRIC_SECRET=your_super_secret_biometric_salt_key_here
AGY_BIOMETRIC_DB_PATH=~/.gemini/antigravity-cli/faces_db.enc

# 6. Session Management (session module)
AGY_BRAIN_DIR=~/.gemini/antigravity-cli/brain

# 7. Safe Probing Sandbox & API Ignore (doc module)
AGY_DEV_DB_SANDBOX_DIR=~/Desktop/temp/sandbox_db
AGY_PROBE_SAFE_TABLES=branches,categories,roles,regions,districts,cities,tags,currencies,tariffs,status_types
AGY_API_IGNORE_PATTERNS=*payme*,*click*,*uzum*,*billing*,*webhook*,*sms*,*auth/login*,*checkout*
