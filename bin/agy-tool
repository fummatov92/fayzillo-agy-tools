#!/usr/bin/env python3
import sys
import os
import argparse
import json
import time

# Add parent dir to sys.path to allow module imports
current_dir = os.path.dirname(os.path.abspath(__file__))
parent_dir = os.path.dirname(current_dir)
if parent_dir not in sys.path:
    sys.path.insert(0, parent_dir)

from agy_tools.modules import sys_tool, code_tool, secure_tool, debug_tool, doc_tool, media_tool
from agy_tools.utils import emit_result, set_checkpoint_hook, set_result_hook
from agy_tools.logger import RunLogger, get_logger


def extract_session_flags(argv):
    """Pre-parses and extracts --session-id and --session-path from any position in sys.argv."""
    session_id = os.environ.get("AGY_CONVERSATION_ID", "unknown")
    session_path = os.environ.get("AGY_SESSION_PATH", "")
    filtered_argv = [argv[0]]
    i = 1
    while i < len(argv):
        arg = argv[i]
        if arg == "--session-id":
            if i + 1 < len(argv):
                session_id = argv[i + 1]
                i += 2
                continue
        elif arg.startswith("--session-id="):
            session_id = arg.split("=", 1)[1]
            i += 1
            continue
        elif arg == "--session-path":
            if i + 1 < len(argv):
                session_path = argv[i + 1]
                i += 2
                continue
        elif arg.startswith("--session-path="):
            session_path = arg.split("=", 1)[1]
            i += 1
            continue
        filtered_argv.append(arg)
        i += 1
    return filtered_argv, session_id, session_path


def build_parser():
    parser = argparse.ArgumentParser(
        prog="agy-tool",
        description="JarvisOS & AGY Dynamic Autonomous Toolsuite for High-Speed & Token-Efficient Operations."
    )
    parser.add_argument("--describe", action="store_true", help="Return schema and capabilities of all tools in JSON")
    parser.add_argument("--session-id", help="AGY Conversation / Session ID")
    parser.add_argument("--session-path", help="AGY Workspace / Session Path")

    subparsers = parser.add_subparsers(dest="module", help="Tool modules")

    # === SYS MODULE ===
    sys_p = subparsers.add_parser("sys", help="System resources, ports & docker monitoring")
    sys_sub = sys_p.add_subparsers(dest="action")

    sys_ports_p = sys_sub.add_parser("ports", help="Scan allocated ports (15800-15900)")
    sys_ports_p.add_argument("--start", dest="start_port", type=int, default=15800)
    sys_ports_p.add_argument("--end", dest="end_port", type=int, default=15900)

    sys_sub.add_parser("status", help="Get CPU, RAM and Disk status")
    sys_sub.add_parser("docker", help="Get rootless docker containers status")

    sys_lr = sys_sub.add_parser("last-run", help="Show last executed command audit details")
    sys_lr.add_argument("--table", action="store_true", help="Display human-readable table format")
    sys_lr.add_argument("--format", choices=["json", "table"], default="table", help="Output format (default: table)")
    sys_lr.add_argument("--all", action="store_true", help="Include meta commands (last-run / logs)")

    sys_logs = sys_sub.add_parser("logs", help="Query and inspect audit log history")
    sys_logs.add_argument("-n", "--limit", type=int, default=20, help="Number of records to show (default: 20)")
    sys_logs.add_argument("-e", "--errors-only", action="store_true", help="Show only failed / error runs")
    sys_logs.add_argument("-s", "--session-id", dest="query_session_id", default=None, help="Filter by session ID")
    sys_logs.add_argument("--table", action="store_true", help="Display human-readable table format")
    sys_logs.add_argument("--format", choices=["json", "table"], default="table", help="Output format (default: table)")

    # === CODE MODULE ===
    code_p = subparsers.add_parser("code", help="AST & architectural blueprints extraction")
    code_sub = code_p.add_subparsers(dest="action")

    code_bp = code_sub.add_parser("blueprint", help="Extract high-level file and module map")
    code_bp.add_argument("path", nargs="?", default=".", help="Project path")

    code_ep = code_sub.add_parser("endpoints", help="Extract API routes / endpoints")
    code_ep.add_argument("path", nargs="?", default=".", help="Project path")

    code_sym = code_sub.add_parser("symbols", help="Extract class and function signatures from file or directory")
    code_sym.add_argument("path", nargs="?", default=".", help="Target file or directory path")

    # === SECURE MODULE ===
    sec_p = subparsers.add_parser("secure", help="Security sanitization and secret masking")
    sec_sub = sec_p.add_subparsers(dest="action")

    sec_scan = sec_sub.add_parser("scan", help="Scan files for leaked credentials")
    sec_scan.add_argument("path", help="Target file or directory")

    sec_redact = sec_sub.add_parser("redact", help="Redact secrets in place")
    sec_redact.add_argument("path", help="Target file path")
    sec_redact.add_argument("--dry-run", action="store_true", help="Do not overwrite file")

    # === DEBUG MODULE ===
    dbg_p = subparsers.add_parser("debug", help="Error log diagnosis, stacktrace parser and typecheck")
    dbg_sub = dbg_p.add_subparsers(dest="action")

    dbg_trace = dbg_sub.add_parser("trace", help="Analyze stack trace log")
    dbg_trace.add_argument("log", nargs="?", default="", help="Raw stack trace string or log")

    dbg_chk = dbg_sub.add_parser("check", help="Fast syntax / typecheck")
    dbg_chk.add_argument("path", nargs="?", default=".", help="Target project directory")

    # === DOC MODULE ===
    doc_p = subparsers.add_parser("doc", help="Multi-Framework Zero-Token API Kontrakt & DTO Generator")
    doc_p.add_argument("path", nargs="?", default=".", help="Project path to scan or subaction (generate, probe, sync-db)")
    doc_p.add_argument("--export", default="md,ts,postman", help="Export formats (comma-separated: md,ts,postman)")
    doc_p.add_argument("--output-dir", help="Directory where docs, types, postman folders will be created")
    doc_p.add_argument("--force", action="store_true", help="Bypass cache and force re-scan")
    doc_p.add_argument("--probe", action="store_true", help="Perform safe active probing on GET endpoints if local server is running")
    doc_p.add_argument("--probe-db", action="store_true", help="Enable Dev DB Sandbox provisioning & data sync before probing")
    doc_p.add_argument("--dev-db", help="Dev DB Connection URL (e.g. postgresql://user:pass@127.0.0.1:15842/dev_db or sqlite:///path/to/dev.db)")
    doc_p.add_argument("--dev-docker", help="Dev Rootless Docker container name for sandbox DB")
    doc_p.add_argument("--probe-url", "--base-url", dest="probe_url", help="Target base URL for probing (e.g. http://127.0.0.1:15801)")
    doc_p.add_argument("--source-db", help="Source DB URL for safe snapshot sync")
    doc_p.add_argument("--safe-tables", help="Comma-separated list of allowed tables for data sync")

    # === MEDIA MODULE ===
    med_p = subparsers.add_parser("media", help="Interoperable Media Intelligence (video, audio, image, archive, text, pipeline)")
    med_sub = med_p.add_subparsers(dest="action")

    # video
    med_vid = med_sub.add_parser("video", help="Extract metadata, keyframes and audio from video")
    med_vid.add_argument("path", help="Video file path")
    med_vid.add_argument("--interval", default="5s", help="Frame extraction interval (e.g. 5s, 2)")
    med_vid.add_argument("--keyframes", action="store_true", help="Extract only I-Frames (keyframes)")
    med_vid.add_argument("--scene-change", type=float, nargs="?", const=0.3, default=None, help="Scene change threshold (default: 0.3)")
    med_vid.add_argument("--extract-audio", action="store_true", help="Extract audio track into separate WAV file")
    med_vid.add_argument("--output-dir", help="Output directory for extracted frames/audio")
    med_vid.add_argument("--max-frames", type=int, default=20, help="Maximum number of frames to extract")

    # audio
    med_aud = med_sub.add_parser("audio", help="Audio metadata, chunking and speech-to-text")
    med_aud.add_argument("path", help="Audio file path")
    med_aud.add_argument("--chunk-size", type=int, default=30, help="Chunk length in seconds (default: 30)")
    med_aud.add_argument("--silence-removal", action="store_true", help="Filter out silence from audio")
    med_aud.add_argument("--transcribe", action="store_true", default=True, help="Perform Speech-to-Text transcription")
    med_aud.add_argument("--no-transcribe", dest="transcribe", action="store_false", help="Skip STT transcription")
    med_aud.add_argument("--language", default="uz-UZ", help="STT target language (e.g. uz-UZ, en-US)")
    med_aud.add_argument("--output-dir", help="Output directory for audio chunks")

    # image
    med_img = med_sub.add_parser("image", help="Image analysis, EXIF, dHash/aHash, dominant colors and OCR")
    med_img.add_argument("path", help="Image file path")
    med_img.add_argument("--palette-size", type=int, default=5, help="Number of dominant colors to extract")
    med_img.add_argument("--no-ascii", dest="ascii_preview", action="store_false", help="Disable ASCII visual grid preview")
    med_img.add_argument("--base64", action="store_true", help="Include Base64 data URI")
    med_img.add_argument("--no-ocr", dest="ocr", action="store_false", help="Disable OCR extraction")

    # archive
    med_arc = med_sub.add_parser("archive", help="ZIP/TAR inspection, safe tree and view-file")
    med_arc.add_argument("path", help="Archive file path (.zip, .tar, .tar.gz, etc.)")
    med_arc.add_argument("--view-file", help="View internal file contents safely in-memory")
    med_arc.add_argument("--max-depth", type=int, default=5, help="Maximum directory depth to scan")

    # text
    med_txt = med_sub.add_parser("text", help="Markdown/Doc structure and 0-token statistical summary")
    med_txt.add_argument("path", help="Text/Markdown/PDF/JSON file path")
    med_txt.add_argument("--keywords", type=int, default=10, help="Number of top keywords to extract")

    # pipeline
    med_pip = med_sub.add_parser("pipeline", help="Multimodal intelligence pipeline")
    med_pip.add_argument("path", help="Target media file path")
    med_pip.add_argument("--output-dir", help="Output directory for pipeline artifacts")

    return parser


def main():
    raw_argv = list(sys.argv)
    filtered_argv, session_id, session_path = extract_session_flags(raw_argv)
    caller_cwd = os.environ.get("AGY_CALLER_CWD", os.getcwd())

    logger = get_logger()
    set_checkpoint_hook(lambda step, pct=None, detail=None: logger.checkpoint(step, pct, detail))

    result_captured = {"success": True, "error": None}

    def on_result(data, success=True, error=None):
        result_captured["success"] = success
        result_captured["error"] = error
        logger.set_result(success, error)

    set_result_hook(on_result)

    parser = build_parser()

    try:
        args = parser.parse_args(filtered_argv[1:])
    except SystemExit as se:
        if se.code != 0:
            logger.start_run(
                command="cli_parse_error",
                args=raw_argv[1:],
                session_id=session_id,
                session_path=session_path,
                caller_cwd=caller_cwd
            )
            logger.end_run(status="ERROR", error_detail=f"CLI parse error (exit code {se.code})")
        sys.exit(se.code)

    # Attach session context to args
    args.session_id = session_id
    args.session_path = session_path

    # Determine command
    if args.describe or not args.module:
        command = "--describe"
    else:
        command = f"{args.module} {getattr(args, 'action', '') or ''}".strip()

    logger.start_run(
        command=command,
        args=raw_argv[1:],
        session_id=session_id,
        session_path=session_path,
        caller_cwd=caller_cwd
    )

    exit_code = 0
    try:
        if args.describe or not args.module:
            capabilities = {
                "name": "agy-tool",
                "version": "1.3.0",
                "modules": {
                    "sys": sys_tool.get_sys_describe(),
                    "code": code_tool.get_code_describe(),
                    "secure": secure_tool.get_secure_describe(),
                    "debug": debug_tool.get_debug_describe(),
                    "doc": doc_tool.get_doc_describe(),
                    "media": media_tool.get_media_describe()
                }
            }
            emit_result(capabilities)
            return

        if args.module == "sys":
            if args.action == "ports":
                sys_tool.run_sys_ports(args)
            elif args.action == "docker":
                sys_tool.run_sys_docker(args)
            elif args.action == "last-run":
                sys_tool.run_sys_last_run(args)
            elif args.action == "logs":
                sys_tool.run_sys_logs(args)
            elif args.action == "status" or not args.action:
                sys_tool.run_sys_status(args)
            else:
                emit_result(None, success=False, error=f"Noma'lum sys buyrug'i: {args.action}")
                exit_code = 1

        elif args.module == "code":
            if args.action == "blueprint":
                code_tool.run_code_blueprint(args)
            elif args.action == "endpoints":
                code_tool.run_code_endpoints(args)
            elif args.action == "symbols":
                code_tool.run_code_symbols(args)
            else:
                emit_result(None, success=False, error=f"Noma'lum code buyrug'i: {args.action}")
                exit_code = 1

        elif args.module == "secure":
            if args.action == "scan":
                secure_tool.run_secure_scan(args)
            elif args.action == "redact":
                secure_tool.run_secure_redact(args)
            else:
                emit_result(None, success=False, error=f"Noma'lum secure buyrug'i: {args.action}")
                exit_code = 1

        elif args.module == "debug":
            if args.action == "trace":
                debug_tool.run_debug_trace(args)
            elif args.action == "check" or not args.action:
                debug_tool.run_debug_check(args)
            else:
                emit_result(None, success=False, error=f"Noma'lum debug buyrug'i: {args.action}")
                exit_code = 1

        elif args.module == "doc":
            doc_tool.run_doc_generate(args)

        elif args.module == "media":
            if args.action == "video":
                media_tool.run_video(args)
            elif args.action == "audio":
                media_tool.run_audio(args)
            elif args.action == "image":
                media_tool.run_image(args)
            elif args.action == "archive":
                media_tool.run_archive(args)
            elif args.action == "text":
                media_tool.run_text(args)
            elif args.action == "pipeline" or not args.action:
                media_tool.run_pipeline(args)
            else:
                if os.path.exists(args.action):
                    args.path = args.action
                    media_tool.run_pipeline(args)
                else:
                    emit_result(None, success=False, error=f"Noma'lum media buyrug'i: {args.action}")
                    exit_code = 1

        else:
            emit_result(None, success=False, error=f"Noma'lum modul: {args.module}")
            exit_code = 1

    except Exception as e:
        exit_code = 1
        emit_result(None, success=False, error=str(e))
    finally:
        status = "ERROR" if (exit_code != 0 or not result_captured["success"]) else "SUCCESS"
        error_detail = result_captured["error"]
        logger.end_run(status=status, error_detail=error_detail)
        if exit_code != 0:
            sys.exit(exit_code)


if __name__ == "__main__":
    main()
